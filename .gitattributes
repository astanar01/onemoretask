# Windows scripts need CRLF; sh scripts break with it (a Windows clone with core.autocrlf would add it).
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
bin/onemoretask text eol=lf
# Two branches adding changelog lines under the same day keep both sides' lines, so a merge needs no hand fix.
whats-new.md merge=union
