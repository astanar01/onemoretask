#!/bin/sh
# Start the task board server, then open it in the browser. If it is already running, just open it.
# Extra arguments go to server.py (e.g. --port 9000, --project PATH). The work is done by launch.py.
command -v python3 >/dev/null || { echo "onemoretask needs python3 — install it first." >&2; exit 1; }
# Resolve symlinks (~/.local/bin/onemoretask points here) to find the repo.
self=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")
dir=$(dirname "$(dirname "$self")")
exec python3 "$dir/launch.py" "$@"
